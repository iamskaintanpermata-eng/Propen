{
  "name": "sipes-unand-backend",
  "version": "1.0.0",
  "description": "Backend API untuk SIPES UNAND - Sistem Informasi Pengelolaan Sampah Universitas Andalas",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
