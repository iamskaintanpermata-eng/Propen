// Prisma Schema for SIPES UNAND
// Berdasarkan ERD dan Class Diagram resmi

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Pengguna {
  id_pengguna   String   @id @map("id_pengguna")
  username      String   @unique @map("username")
  password      String   @map("password")
  nama_lengkap  String   @map("nama_lengkap")
  nomor_kontak  String   @map("nomor_kontak")
  peran         String   @map("peran") // 'admin', 'petugas_gedung', 'sopir_bentor'
  created_at    DateTime @default(now()) @map("created_at")

  // Relasi
  laporan_dibuat         LaporanSampah[]         @relation("PetugasLaporan")
  penugasan_dikelola     PenugasanPengangkutan[] @relation("AdminPenugasan")
  penugasan_dikendarai   PenugasanPengangkutan[] @relation("SopirPenugasan")
  verifikasi_pembuangan  LogPembuanganAkhir[]    @relation("AdminVerifikator")

  @@map("PENGGUNA")
}

model Gedung {
  id_gedung       String   @id @map("id_gedung")
  nama_gedung     String   @map("nama_gedung")
  fakultas        String   @map("fakultas")
  koordinat_lat   Float    @map("koordinat_lat")
  koordinat_long  Float    @map("koordinat_long")
  kapasitas_tps   Int      @map("kapasitas_tps")

  // Relasi
  laporan_sampah  LaporanSampah[]

  @@map("GEDUNG")
}

model ArmadaBentor {
  id_bentor               String   @id @map("id_bentor")
  plat_nomor              String   @unique @map("plat_nomor")
  kapasitas_maks_kantong  Int      @map("kapasitas_maks_kantong")
  status_operasional      String   @default("tersedia") @map("status_operasional") // 'tersedia', 'beroperasi', 'perbaikan'

  // Relasi
  penugasan               PenugasanPengangkutan[]

  @@map("ARMADA_BENTOR")
}

model LaporanSampah {
  id_laporan       String   @id @map("id_laporan")
  id_gedung        String   @map("id_gedung")
  id_petugas       String   @map("id_petugas")
  tanggal_lapor    DateTime @default(now()) @map("tanggal_lapor")
  jumlah_kantong   Int      @map("jumlah_kantong")
  kondisi_sampah   String   @map("kondisi_sampah") // 'Normal', 'Hampir Penuh', 'Penuh', 'Mendesak'
  catatan          String?  @map("catatan")
  url_foto_sampah  String   @map("url_foto_sampah")
  status_laporan   String   @default("Menunggu Penugasan") @map("status_laporan") // 'Menunggu Penugasan', 'Ditugaskan', 'Selesai'

  // Relasi
  gedung           Gedung                 @relation(fields: [id_gedung], references: [id_gedung], onDelete: Cascade)
  petugas          Pengguna               @relation("PetugasLaporan", fields: [id_petugas], references: [id_pengguna], onDelete: Cascade)
  detail_penugasan DetailPenugasan[]

  @@map("LAPORAN_SAMPAH")
}

model PenugasanPengangkutan {
  id_penugasan           String   @id @map("id_penugasan")
  id_admin               String   @map("id_admin")
  id_sopir               String   @map("id_sopir")
  id_bentor              String   @map("id_bentor")
  tanggal_penugasan      DateTime @default(now()) @map("tanggal_penugasan")
  total_rencana_kantong  Int      @map("total_rencana_kantong")
  estimasi_jarak_km      Float?   @map("estimasi_jarak_km")
  nama_lokasi_tpa_target String   @default("TPA Kampus Unand") @map("nama_lokasi_tpa_target")
  status_tugas           String   @default("Ditugaskan") @map("status_tugas") // 'Ditugaskan', 'Dalam Proses', 'Selesai', 'Terverifikasi'

  // Relasi
  admin                  Pengguna             @relation("AdminPenugasan", fields: [id_admin], references: [id_pengguna])
  sopir                  Pengguna             @relation("SopirPenugasan", fields: [id_sopir], references: [id_pengguna])
  bentor                 ArmadaBentor         @relation(fields: [id_bentor], references: [id_bentor])
  detail_penugasan       DetailPenugasan[]
  log_pembuangan_akhir   LogPembuanganAkhir?

  @@map("PENUGASAN_PENGANGKUTAN")
}

model DetailPenugasan {
  id_detail       String   @id @map("id_detail")
  id_penugasan    String   @map("id_penugasan")
  id_laporan      String   @map("id_laporan")
  urutan_singgah  Int      @map("urutan_singgah")
  status_singgah  String   @default("Menunggu") @map("status_singgah") // 'Menunggu', 'Selesai'

  // Relasi
  penugasan       PenugasanPengangkutan @relation(fields: [id_penugasan], references: [id_penugasan], onDelete: Cascade)
  laporan         LaporanSampah         @relation(fields: [id_laporan], references: [id_laporan], onDelete: Cascade)
  log_penjemputan LogPenjemputan?

  @@map("DETAIL_PENUGASAN")
}

model LogPenjemputan {
  id_log_jemput          String   @id @map("id_log_jemput")
  id_detail              String   @unique @map("id_detail")
  waktu_jemput           DateTime @default(now()) @map("waktu_jemput")
  jumlah_kantong_aktual  Int      @map("jumlah_kantong_aktual")
  url_foto_jemput        String   @map("url_foto_jemput")
  catatan                String?  @map("catatan")

  // Relasi
  detail                 DetailPenugasan @relation(fields: [id_detail], references: [id_detail], onDelete: Cascade)

  @@map("LOG_PENJEMPUTAN")
}

model LogPembuanganAkhir {
  id_log_buang            String   @id @map("id_log_buang")
  id_penugasan            String   @unique @map("id_penugasan")
  id_admin_verifikator    String?  @map("id_admin_verifikator")
  waktu_buang             DateTime @default(now()) @map("waktu_buang")
  nama_lokasi_tpa         String   @map("nama_lokasi_tpa")
  koordinat_lat_tpa       Float    @map("koordinat_lat_tpa")
  koordinat_long_tpa      Float    @map("koordinat_long_tpa")
  jumlah_kantong_dibuang  Int      @map("jumlah_kantong_dibuang")
  url_foto_bukti_tpa      String   @map("url_foto_bukti_tpa")
  status_verifikasi       String   @default("Menunggu Verifikasi") @map("status_verifikasi") // 'Menunggu Verifikasi', 'Terverifikasi', 'Ditolak'
  catatan_verifikasi      String?  @map("catatan_verifikasi")

  // Relasi
  penugasan               PenugasanPengangkutan @relation(fields: [id_penugasan], references: [id_penugasan], onDelete: Cascade)
  admin_verifikator       Pengguna?             @relation("AdminVerifikator", fields: [id_admin_verifikator], references: [id_pengguna])

  @@map("LOG_PEMBUANGAN_AKHIR")
}
