{
  "name": "sipes-unand",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aplikasi lokal SIPES UNAND",
  "scripts": {
    "dev": "docker compose --env-file backend/.env up --build",
    "dev:frontend": "npm --prefix frontend run dev -- --host 127.0.0.1",
    "dev:backend": "npm --prefix backend run dev",
    "db:up": "docker compose --env-file backend/.env up -d db",
    "db:down": "docker compose --env-file backend/.env stop db",
    "deploy:local": "docker compose --env-file backend/.env up -d --build",
    "setup:db": "node scripts/setup-db.js",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint"
  }
}
