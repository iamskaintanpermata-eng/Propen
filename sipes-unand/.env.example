PORT=5000
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
# DATABASE_URL="mysql://root:@localhost:3306/sipes_unand"

# PostgreSQL lokal dari Docker Compose.
DATABASE_URL=postgresql://sipes_app:sipes_dev_only_local@localhost:5433/sipes_unand?schema=public
POSTGRES_DB=sipes_unand
POSTGRES_USER=sipes_app
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
POSTGRES_PORT=5433
APP_PORT=8080
APP_DOMAIN=localhost

UPLOAD_DIR="../uploads"
BASE_URL=http://localhost:8080
AUTO_ASSIGNMENT_LOAD_PERCENT=80
OFFICIAL_DISPOSAL_NAME="PPST UNAND"
OFFICIAL_DISPOSAL_LATITUDE=-0.915703
OFFICIAL_DISPOSAL_LONGITUDE=100.463788
OFFICIAL_DISPOSAL_RADIUS_METERS=100
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sipes-unand.local
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PHONE=
